# WorkLog AI - Environment Variables Reference
# 
# NOTE: WorkLog AI is an offline-first desktop application.
# Under normal operation, NO environment variables or API keys are required.
# Everything runs locally out of the box.

# Optional: Custom database directory override (defaults to OS user data directory)
# WORKLOG_DB_DIR=

# Optional: Custom backup directory override (defaults to ~/.config/WorkLogAI/backups)
# WORKLOG_BACKUP_DIR=

# Optional: Tauri development logging level (trace, debug, info, warn, error)
# RUST_LOG=info
